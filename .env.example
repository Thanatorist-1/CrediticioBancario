# Variables requeridas por Spring Boot. No subas el archivo .env real.
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-o-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario_postgres>
SPRING_DATASOURCE_PASSWORD=<contrasena_postgres>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret-key-solo-servidor>
